# The indexer image (apps/indexer/Dockerfile) needs the workspace manifests, packages/core and
# apps/indexer; everything else stays out of the build context.
**/node_modules
**/.data
**/.env
**/.env.*
**/*.db
**/*.db-shm
**/*.db-wal
**/*.log
**/.DS_Store
.git
.github
design
apps/web/*
!apps/web/package.json
