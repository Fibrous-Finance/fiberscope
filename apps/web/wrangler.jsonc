{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fiberscope",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	// The indexer uploads the snapshot here; the site reads it through the binding.
	"r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "fiberscope-data" }],
	"vars": {
		"SNAPSHOT_R2_KEY": "base/snapshot.json",
		// The site's origin, for absolute link-preview URLs.
		"SITE_URL": "https://fiberscope.kermo.workers.dev",
		// Search engines are kept out (noindex) until launch; set "true" then.
		"ALLOW_INDEXING": "false",
	},
	// Branch and pull-request builds get their own preview URLs (Workers Builds).
	"preview_urls": true,
	"observability": {
		"enabled": true,
	},
}
