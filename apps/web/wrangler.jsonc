{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fiberscope",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-02",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
	},
	// The indexers upload each network's snapshot here; the site reads them through the binding.
	"r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "fiberscope-data" }],
	"vars": {
		// Each network's page reads <network>/snapshot.json from SNAPSHOTS, not a local file.
		"SNAPSHOT_SOURCE": "r2",
		// The site's origin, for absolute link-preview URLs.
		"SITE_URL": "https://fiberscope.org",
		// "true" lets search engines index SITE_URL's host, and only that host; any other value
		// makes every page noindex.
		"ALLOW_INDEXING": "true",
	},
	// Uploaded versions get their own preview URLs (the deploy workflow uploads one per pull request).
	"preview_urls": true,
	"observability": {
		"enabled": true,
	},
}
