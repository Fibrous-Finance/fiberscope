# Response headers for the static assets the Worker serves.
# https://developers.cloudflare.com/workers/static-assets/headers
# Next fingerprints everything under /_next/static/, so a file there never changes:
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# The icons and the social image keep their names when they change, so they are cached for a day:
/og-image.png
  Cache-Control: public,max-age=86400
/favicon.svg
  Cache-Control: public,max-age=86400
/favicon.ico
  Cache-Control: public,max-age=86400
/apple-touch-icon.png
  Cache-Control: public,max-age=86400

# Static files on workers.dev hosts stay out of search results. They are served before the Worker
# runs, so they skip its redirect to fiberscope.org on the Worker's own address and the pages'
# noindex on pull-request previews. https://developers.cloudflare.com/workers/static-assets/headers
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
